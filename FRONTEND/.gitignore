# dependencies
/node_modules
/dist
/build
/out

# build output (common for various bundlers)
.vite
.parcel-cache
.rollup.cache
.svelte-kit
.next
.nuxt
.vuepress/dist

# dotenv environment variables
.env
.env.*.local  # ignore local environment variables, including .env.local, {Link: according to Vite documentation https://vite.dev/guide/env-and-mode}

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# osx
.DS_Store
.AppleDouble
.LSOverride

# thumbnail cache files
._*

# files that might get created by system or editor
.idea
.vscode
*.swp
*.bak
*~
.editorconfig

# output of 'npm pack'
*.tgz

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# testing coverage
coverage
.nyc_output

# type definition files
*.tsbuildinfo

# optional npm cache directory
.npm

# optional eslint cache
.eslintcache

# other common ignore patterns
temp/
tmp/
*.tmp
*.local  # ignore any local-only files, {Link: according to Vite documentation https://vite.dev/guide/env-and-mode}
